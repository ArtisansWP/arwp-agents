<?xml version="1.0"?>
<ruleset name="ARWP Agents">
	<description>WordPress coding standards for ARWP Agents.</description>

	<file>.</file>
	<arg name="extensions" value="php"/>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<!-- WordPress loads this exact filename beside a block editor script. -->
	<exclude-pattern>*/blocks/chat/index.asset.php</exclude-pattern>

	<rule ref="WordPress"/>
</ruleset>
